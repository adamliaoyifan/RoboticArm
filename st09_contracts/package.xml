<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>st09_contracts</name>
  <version>0.1.0</version>
  <description>Frozen ROS-free ST09 planning contracts: value objects, protocols, reason taxonomy, fixtures, and the resolved planning contract manifest.</description>
  <maintainer email="dev@todo.todo">RobotArm</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Pure stdlib package: dataclasses/enum/typing/math only. The frozen
       JSON manifests stay at the repository root for tooling; production
       code consumes the values as baked Python constants. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
