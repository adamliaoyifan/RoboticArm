# Retain exactly this currently published measured acquisition, without renewal.
string request_id
string observation_id
string domain_sha256
luggage_msgs/DetectedLuggage detection
uint64 generation
string expected_quality_policy_sha256
# Nonempty binding checks that existing retention only; never recreates/renews it.
luggage_msgs/FrozenSuctionObservationV2 expected_binding
---
bool retained
string reason
luggage_msgs/FrozenSuctionObservationV2 binding
# Optional recovery inputs; these diagnostics do not change quality admission.
bool pickup_view_available
string pickup_view_reason
uint64 retained_observation_bytes
