# Plan only. Must not move joints, change vacuum, attach, release or commit OCC.
string request_id
luggage_msgs/DetectedLuggage detection
string observation_id
uint64 generation
string geometry_hash
uint64 expected_map_revision
# Default O requires a positive epoch; G compatibility ignores this field.
uint64 expected_map_epoch
string expected_model_sha256
# Measured robot state at observation, canonical elfin_joint1..elfin_joint6 order.
bool robot_state_stamp_valid
uint64 robot_state_stamp_ns
float64[6] start_joints
# Optional task intent: empty = existing default, floor or stack.
# Enumerated inside preparation after the measured observation is retained.
# Must not be combined with caller-provided slots.
string placement_task_mode
# Empty slots asks the placement solver to enumerate on the pinned snapshot.
luggage_msgs/PoseContractV2[] slots
# Number of admitted placement proposals, 1..8; each tries two directed headings.
# Contact alternatives per heading are separately bounded by the prepare owner.
# The shared time budget still bounds native planning across all proposals.
uint32 candidate_limit
float64 budget_s
---
# PLAN_READY requires complete certified pick/carry/place/retreat trajectories.
# Other outcomes keep plan at its inactive default, including SEARCH_INCOMPLETE.
bool success
string reason
luggage_msgs/JointOperationPlanV2 plan
string trace_json
float64 elapsed_s
