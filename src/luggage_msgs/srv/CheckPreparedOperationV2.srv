# Read-only check against the preparation owner's retained issued plan.
# This does not assert current source/attachment/path validity or execute motion.
luggage_msgs/JointOperationPlanV2 plan
---
bool current
string reason
# Independently retained owner provenance; not current observation/path permission.
luggage_msgs/FrozenSuctionObservationV2 frozen_observation
# Bound for the default O source; legacy G has bound=false.
luggage_msgs/OperationMapSourceV2 map_source
