# Ask the placement planner for one slot inside the container.
#
# ``geometry_hash`` pins the container hull the caller reasoned about. Leave it
# empty to accept the planner's own kernel geometry; a non-empty value that
# differs from the planner hull fails closed with
# ``reason_code=CARGO_MAP_GEOMETRY_MISMATCH``.
DetectedLuggage box
SlotSpec[] placed
string geometry_hash
# 0 = planner default (config, typically 5). Ranked feasible slots returned
# in ``candidates`` so a later path selector can try more than one target.
int32 max_candidates
---
SlotSpec slot
bool success
string message
# Hull the answer was computed against (kernel geometry_hash).
string geometry_hash
# Stable failure taxonomy; empty on success. BIN_FULL is a capacity claim and
# must never be used for candidates lost to aperture, corridor, support or
# observation gates - those are PLACE_CANDIDATE_EXHAUSTED.
string reason_code
# Score-sorted feasible slots; candidates[0] matches ``slot`` on success.
SlotSpec[] candidates
float64[] candidate_scores
string[] candidate_reasons
