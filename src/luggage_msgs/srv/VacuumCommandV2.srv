# Measured attachment snapshot. v1 VacuumCommand is unchanged.
# box_pose is the measured world box center at the acquisition stamp.
# grasp, when has_grasp is true, is the ST07 box-relative transport.
bool enable
string request_id
string scene_revision
string box_id
uint64 generation
luggage_msgs/DetectedLuggage measured_box
luggage_msgs/PoseContractV2 box_pose
bool has_grasp
luggage_msgs/PoseContractV2 grasp
---
bool success
string message
luggage_msgs/BoundaryDiagnosticV2 diagnostic
# Successful enable returns the exact admitted measured attachment. A planned
# prior grasp is not an attachment observation. Disable/failure leaves false.
bool has_measured_attachment
luggage_msgs/PoseContractV2 measured_grasp
float64[3] attached_box_wdh
luggage_msgs/AttachmentGeometryV2 conservative_geometry
