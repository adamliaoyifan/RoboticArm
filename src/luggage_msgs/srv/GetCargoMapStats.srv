# Compact Cargo occupancy map statistics (no full grid transfer).
---
bool success
string message
float64 unknown_ratio
float64 occupancy_ratio
float64 occupied_volume
float64 free_volume
int32 unknown_count
int32 free_count
int32 occupied_count
int32 frontier_count
int32 total_voxels
int64 map_revision
# Kernel geometry_hash of the hull this map describes.
string geometry_hash
# Sensor stamp (ns) of the last integrated settled view; 0 = the map
# has never been observed. This is the freshness datum for admission —
# the surface records themselves are scene-basis (stamp 0) by contract.
int64 last_acquisition_stamp_ns
