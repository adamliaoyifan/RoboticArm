# Plan and execute one typed motion segment. v1 PlanMotion is unchanged.
luggage_msgs/MotionSegmentV2 segment
# [ST09-I S5.7-3b] Execution admission (empty = the goal makes no
# admission claim: pick legs are certified atomically in the build
# call; test/legacy goals). When set, the executor verifies the
# generation is STILL live against the certifier side before the first
# controller submission — and again for every later leg (each leg is
# its own goal): certify A, execute A, and the certification still
# holds when A executes.
string route_digest
string certification_id
uint64 admission_map_revision
# Per-leg scope of the same admission (empty = route-level only).
string admission_leg_digest
string admission_load_state
---
bool success
string message
float64 fraction
bool used_ompl_fallback
int32 moveit_error_code
string settle_json
# [ST09-I S5.7-6] execution-admission liveness RPC duration (ms; 0
# when the goal made no admission claim).
float64 admission_check_ms
luggage_msgs/BoundaryDiagnosticV2 diagnostic
---
string stage
string segment_name
float64 fraction
