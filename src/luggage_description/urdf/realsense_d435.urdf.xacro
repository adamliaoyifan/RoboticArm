<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="realsense_d435">

  <!--
    Hardware is D555 PoE in a D555-sized printed pocket (not a D435 90 mm
    pocket). camera_link +X = forward; +Y = stereo baseline / long axis;
    +Z = height. Visual/collision use D555 Datasheet v1.1 envelope
    167 x 42 x 48 mm (L x H x D). camera_link is left IR (d555_link identity).
    Front face at camera_link +X = 0; body extends -X into the mount.
    Y offset 47.5 mm is half of the 95 mm stereo baseline.
    cam_mount_* (ChArUco Layer 3) is the optical/body pose and is not this box.
  -->
  <xacro:macro name="realsense_d435" params="parent *origin depth_near:=0.26 depth_far:=3.0">
    <xacro:property name="d435_cam_depth_to_color_offset" value="0.015"/>
    <xacro:property name="d555_cam_depth" value="0.048"/>
    <xacro:property name="d555_cam_length" value="0.167"/>
    <xacro:property name="d555_cam_height" value="0.042"/>
    <xacro:property name="d555_cam_py" value="0.0475"/>

    <link name="camera_link">
      <visual>
        <origin xyz="${-d555_cam_depth/2} ${-d555_cam_py} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${d555_cam_depth} ${d555_cam_length} ${d555_cam_height}"/>
        </geometry>
        <material name="camera_grey">
          <color rgba="0.3 0.3 0.3 1"/>
        </material>
      </visual>
      <!-- Lens/front marker on +X face (167 x ~42 mm). -->
      <visual name="camera_lens_marker">
        <origin xyz="0.0005 ${-d555_cam_py} 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.001 ${d555_cam_length} 0.038"/>
        </geometry>
        <material name="camera_lens_dark">
          <color rgba="0.05 0.05 0.15 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${-d555_cam_depth/2} ${-d555_cam_py} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${d555_cam_depth} ${d555_cam_length} ${d555_cam_height}"/>
        </geometry>
      </collision>
      <inertial>
        <!-- D555 datasheet mass is 337 g; tensor is still a nominal visual-model value. -->
        <mass value="0.337"/>
        <inertia ixx="0.003881243" ixy="0.0" ixz="0.0"
                 iyy="0.000498940" iyz="0.0"
                 izz="0.003879257"/>
      </inertial>
    </link>

    <joint name="camera_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- D555 (PoE) in the printed D555 pocket. camera_link and d555_link are
         two ROS names for the same pose by product contract; this identity is
         not an enclosure-CAD-origin-to-left-IR measurement. cam_mount_* is
         ChArUco Layer 3. The driver publishes d555_* child/optical frames from
         d555_link; do not duplicate those here. -->
    <link name="d555_link"/>
    <joint name="d555_body_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="d555_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="camera_depth_frame"/>
    <joint name="camera_depth_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_depth_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="camera_depth_frame"/>
      <child link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_color_frame"/>
    <joint name="camera_color_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_frame"/>
      <origin xyz="0 ${d435_cam_depth_to_color_offset} 0" rpy="0 0 0"/>
    </joint>

    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="camera_color_frame"/>
      <child link="camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Gazebo Fortress rgbd_camera sensor (replaces the Classic openni_kinect
         plugin). Publishes on gz topics under .../sensor/d435/ (image,
         depth_image, camera_info); ros_gz_bridge maps them onto the same
         camera/... ROS names the noetic stack consumed. Depth range and FOV
         match the noetic D435 configuration. -->
    <gazebo reference="camera_link">
      <sensor name="d435" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <visualize>false</visualize>
        <topic>d435</topic>
        <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
        <camera name="d435">
          <!-- D555 colour-aligned sim profile (DSIM-1): 640x360 at 15 Hz.
               HFOV 1.56005 rad so fx=(320)/tan(hfov/2) ≈ 323.18, matching
               HB-1 colour K within 2%. One rgbd_camera models aligned
               depth on the colour grid. Near clip 0.26 m is D555 VGA Min-Z.
               Runtime CameraInfo is the acceptance source of truth. -->
          <horizontal_fov>1.56005</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${depth_near}</near>
            <far>${depth_far}</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>323.1775</fx>
              <fy>322.8994</fy>
              <cx>317.7526</cx>
              <cy>178.0294</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <depth_camera>
            <output>depths</output>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
