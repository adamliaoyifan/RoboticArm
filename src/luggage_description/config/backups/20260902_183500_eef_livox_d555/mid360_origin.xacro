<?xml version="1.0"?>
<!-- Mid-360S frames (Livox Mid-360 / Mid-360S user manual).

     livox_frame (point-cloud / ROS header):
       Origin = optical centre of the LiDAR (not the housing bottom, not IMU).
       +X = default heading (out the "front"), +Y = left, +Z = up, right-handed.
       Driver publishes /livox/lidar in this frame.

     livox_imu_frame:
       Axes parallel to livox_frame (no extra rotation in the manual).
       Origin in livox_frame = (11.0, 23.29, -44.12) mm.
       /livox/imu still uses header frame_id=livox_frame; accel is in g.

     mid360_mount_frame:
       Seating plane is the ~65 x 65 mm +Y face of arm_realsense_v1.3
       (centroid ~22, 103, 38 mm). rpy 0, π/2, π/2 puts livox +Z along
       adapter +Y (out of that pad) and livox +X along adapter -Z (same
       heading as camera_link +X). Optical centre is still +47 mm along
       mount Z from the plate (handbook). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="mid360_mount_xyz" value="0.022 0.103 0.038"/>
  <xacro:property name="mid360_mount_rpy" value="0 1.57079633 1.57079633"/>
  <!-- Base of the sensor -> livox_frame (optical / point-cloud origin). -->
  <xacro:property name="livox_optical_xyz" value="0.000 0.000 0.047"/>
  <xacro:property name="livox_optical_rpy" value="0 0 0"/>
  <!-- livox_frame -> livox_imu_frame, metres. -->
  <xacro:property name="livox_imu_xyz" value="0.01100 0.02329 -0.04412"/>
  <xacro:property name="livox_imu_rpy" value="0 0 0"/>
</robot>
