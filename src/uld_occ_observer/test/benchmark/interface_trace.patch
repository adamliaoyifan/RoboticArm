diff -ruN src/uld_occ_observer/include/uld_occ_observer/interface_trace.hpp diag/src/uld_occ_observer/include/uld_occ_observer/interface_trace.hpp
--- src/uld_occ_observer/include/uld_occ_observer/interface_trace.hpp	1970-01-01 08:00:00.000000000 +0800
+++ diag/src/uld_occ_observer/include/uld_occ_observer/interface_trace.hpp	2026-10-30 16:22:44.197213617 +0800
@@ -0,0 +1,21 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace uld_occ_observer {
+// 0 = off. The inline check is one relaxed load so the off arm does not take
+// the product locks or write the ring.
+extern std::atomic<int> interface_trace_flag;
+
+void interface_trace_configure_from_env();
+void interface_trace_flush();
+void interface_trace_event_slow(const char* event, const char* request_id,
+                                const char* status, const char* phase);
+
+inline void interface_trace_event(const char* event, const char* request_id,
+                                  const char* status, const char* phase) {
+  if (interface_trace_flag.load(std::memory_order_relaxed) == 0) return;
+  interface_trace_event_slow(event, request_id ? request_id : "",
+                             status ? status : "", phase ? phase : "");
+}
+}  // namespace uld_occ_observer
diff -ruN src/uld_occ_observer/src/interface_probe_cli.cpp diag/src/uld_occ_observer/src/interface_probe_cli.cpp
--- src/uld_occ_observer/src/interface_probe_cli.cpp	1970-01-01 08:00:00.000000000 +0800
+++ diag/src/uld_occ_observer/src/interface_probe_cli.cpp	2026-10-30 16:30:02.788110240 +0800
@@ -0,0 +1,158 @@
+#include "uld_occ_observer/configuration.hpp"
+#include "uld_occ_observer/interface_trace.hpp"
+#include "query_content_digest.hpp"
+
+#include "uld_occ_observer/observer.hpp"
+#include "uld_occ_observer/snapshot_repository.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace {
+using Clock = std::chrono::steady_clock;
+
+double milliseconds(Clock::time_point start, Clock::time_point end) {
+  return std::chrono::duration<double, std::milli>(end - start).count();
+}
+
+std::vector<uld_occ_observer::Vec3> read_points(const std::string& path) {
+  std::ifstream input(path);
+  if (!input) throw uld_occ_observer::Error("POINTS_UNAVAILABLE");
+  std::vector<uld_occ_observer::Vec3> points;
+  double x = 0, y = 0, z = 0;
+  while (input >> x >> y >> z) points.push_back({x, y, z});
+  if (points.size() != 30000) throw uld_occ_observer::Error("POINTS_NOT_30000");
+  return points;
+}
+
+uld_occ_observer::OpticalObservation make_observation(const uld_occ_observer::ObserverConfiguration& config,
+                                                     const std::vector<uld_occ_observer::Vec3>& points,
+                                                     std::uint64_t epoch) {
+  uld_occ_observer::OpticalObservation observation;
+  observation.identity.sensor_id = "cam0";
+  observation.identity.observation_id = "probe-1";
+  observation.identity.optical_frame = "d555_color_optical_frame";
+  observation.identity.clock_domain = config.clock_domain;
+  observation.identity.geometry_hash = config.geometry.geometry_hash;
+  observation.identity.epoch = epoch;
+  observation.identity.stamp_ns = 1000000000;
+  observation.uld_from_optical.stamp_ns = observation.identity.stamp_ns;
+  const double rotation[9] = {0, 0, 1, -1, 0, 0, 0, -1, 0};
+  for (int index = 0; index < 9; ++index) observation.uld_from_optical.rotation[index] = rotation[index];
+  observation.uld_from_optical.translation = {-1.15, 0.0, 1.20};
+  observation.points_m = points;
+  return observation;
+}
+
+std::string content_hash(uld_occ_observer::ObservationStore& store,
+                         uld_occ_observer::SnapshotRepository& repository) {
+  const auto diagnostics = store.diagnostics();
+  const auto lease = repository.acquire(diagnostics.identity.last_integrated_stamp_ns, 0);
+  const auto snapshot = repository.get(lease.handle);
+  const auto shape = store.domain()->shape();
+  const auto page = snapshot->read_cells(
+      {0, 0, 0}, {std::min(16, shape.x), std::min(16, shape.y), std::min(16, shape.z)}, 0, 4096);
+  const auto first = snapshot->surface(nullptr);
+  const auto second = snapshot->surface(nullptr);
+  const auto hash = uld_occ_observer::query_content_sha256(page, first.get(), second.get());
+  repository.release(lease.handle);
+  return hash;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+  if (argc == 2 && std::string(argv[1]) == "--help") {
+    std::cout << "interface_probe_cli --op integrate|acquire|roi|surface "
+                 "--geometry FILE --config FILE --points FILE --out FILE\n"
+              << "Times one fresh-process operation. Trace follows ULD_OCC_INTERFACE_TRACE.\n"
+              << "Content hash is computed outside the timed call. Exit 0 records, 3 fails.\n";
+    return 0;
+  }
+  try {
+    if (argc != 11) throw uld_occ_observer::Error("INVALID_ARGUMENTS");
+    std::map<std::string, std::string> options;
+    for (int index = 1; index < argc; index += 2) {
+      if (!options.emplace(argv[index], argv[index + 1]).second)
+        throw uld_occ_observer::Error("DUPLICATE_OPTION");
+    }
+    const auto op = options.at("--op");
+    if (op != "integrate" && op != "acquire" && op != "roi" && op != "surface")
+      throw uld_occ_observer::Error("INVALID_OP");
+    uld_occ_observer::interface_trace_configure_from_env();
+    const auto config = uld_occ_observer::load_configuration(options.at("--geometry"), options.at("--config"));
+    const auto points = read_points(options.at("--points"));
+    uld_occ_observer::ObservationStore store(config.geometry, config.resolution, config.depth,
+                                            config.clock_domain, config.digest, config.discretize_endpoints);
+    uld_occ_observer::SnapshotRepository repository(store);
+    const auto observation = make_observation(config, points, store.diagnostics().identity.epoch);
+    double sample_ms = 0;
+    double surface_first_ms = -1;
+    double surface_second_ms = -1;
+    std::string status = "OK";
+    if (op == "integrate") {
+      const auto start = Clock::now();
+      const auto receipt = store.integrate(observation);
+      sample_ms = milliseconds(start, Clock::now());
+      status = receipt.status;
+    } else {
+      const auto receipt = store.integrate(observation);
+      status = receipt.status;
+      if (status != "INTEGRATED") throw uld_occ_observer::Error(status);
+      if (op == "acquire") {
+        const auto diagnostics = store.diagnostics();
+        const auto start = Clock::now();
+        const auto lease = repository.acquire(diagnostics.identity.last_integrated_stamp_ns, 0);
+        sample_ms = milliseconds(start, Clock::now());
+        repository.release(lease.handle);
+      } else if (op == "roi") {
+        const auto diagnostics = store.diagnostics();
+        const auto lease = repository.acquire(diagnostics.identity.last_integrated_stamp_ns, 0);
+        const auto snapshot = repository.get(lease.handle);
+        const auto shape = store.domain()->shape();
+        const auto start = Clock::now();
+        const auto page = snapshot->read_cells(
+            {0, 0, 0}, {std::min(16, shape.x), std::min(16, shape.y), std::min(16, shape.z)}, 0, 4096);
+        sample_ms = milliseconds(start, Clock::now());
+        if (page.cells.size() != 4096) throw uld_occ_observer::Error("ROI_LENGTH");
+        repository.release(lease.handle);
+      } else {
+        const auto diagnostics = store.diagnostics();
+        const auto lease = repository.acquire(diagnostics.identity.last_integrated_stamp_ns, 0);
+        const auto snapshot = repository.get(lease.handle);
+        const auto first_start = Clock::now();
+        const auto first = snapshot->surface(nullptr);
+        surface_first_ms = milliseconds(first_start, Clock::now());
+        const auto second_start = Clock::now();
+        const auto second = snapshot->surface(nullptr);
+        surface_second_ms = milliseconds(second_start, Clock::now());
+        sample_ms = surface_first_ms;
+        if (first->size() != second->size() || first->empty()) throw uld_occ_observer::Error("SURFACE_LENGTH");
+        repository.release(lease.handle);
+      }
+    }
+    if (status != "INTEGRATED" && op == "integrate") throw uld_occ_observer::Error(status);
+    const auto hash = content_hash(store, repository);
+    const char* trace = std::getenv("ULD_OCC_INTERFACE_TRACE");
+    std::ofstream output(options.at("--out"));
+    if (!output) throw uld_occ_observer::Error("OUTPUT_UNAVAILABLE");
+    output << "{\n  \"op\": \"" << op << "\",\n  \"trace\": \""
+           << (trace && std::string(trace) == "1" ? "on" : "off")
+           << "\",\n  \"sample_ms\": " << sample_ms
+           << ",\n  \"surface_first_ms\": " << surface_first_ms
+           << ",\n  \"surface_second_ms\": " << surface_second_ms
+           << ",\n  \"content_sha256\": \"" << hash << "\",\n  \"status\": \"" << status
+           << "\",\n  \"not_scored\": true\n}\n";
+    uld_occ_observer::interface_trace_flush();
+    return 0;
+  } catch (const std::exception& error) {
+    std::cerr << error.what() << '\n';
+    uld_occ_observer::interface_trace_flush();
+    return 3;
+  }
+}
diff -ruN src/uld_occ_observer/src/interface_trace.cpp diag/src/uld_occ_observer/src/interface_trace.cpp
--- src/uld_occ_observer/src/interface_trace.cpp	1970-01-01 08:00:00.000000000 +0800
+++ diag/src/uld_occ_observer/src/interface_trace.cpp	2026-10-30 16:41:01.684064050 +0800
@@ -0,0 +1,183 @@
+#include "uld_occ_observer/interface_trace.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <ctime>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+namespace uld_occ_observer {
+namespace {
+constexpr std::uint32_t kCapacity = 65536;
+
+struct Slot {
+  std::atomic<std::uint32_t> ready{0};
+  std::int64_t mono_ns{};
+  std::int64_t thread_cpu_ns{};
+  int pid{};
+  int tid{};
+  std::uint64_t seq{};
+  char event[48]{};
+  char request_id[96]{};
+  char status[96]{};
+  char phase[16]{};
+};
+
+Slot g_slots[kCapacity];
+std::atomic<std::uint32_t> g_write{0};
+std::atomic<std::uint64_t> g_dropped{0};
+std::atomic<std::uint64_t> g_seq{1};
+std::atomic<int> g_started{0};
+std::mutex g_emit_mu;
+std::string g_run_id = "unset";
+FILE* g_file = nullptr;
+std::thread g_flush;
+std::atomic<int> g_stop{0};
+std::uint32_t g_read = 0;
+std::mutex g_flush_mutex;
+
+std::int64_t clock_ns(clockid_t clock) {
+  timespec ts{};
+  clock_gettime(clock, &ts);
+  return static_cast<std::int64_t>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;
+}
+
+void copy_field(char* dest, std::size_t size, const char* value) {
+  if (!value) value = "";
+  std::snprintf(dest, size, "%s", value);
+}
+
+void json_escape(FILE* file, const char* value) {
+  for (const unsigned char* cursor = reinterpret_cast<const unsigned char*>(value); *cursor; ++cursor) {
+    if (*cursor == '"' || *cursor == '\\') std::fputc('\\', file);
+    if (*cursor >= 32) std::fputc(*cursor, file);
+  }
+}
+
+void write_slot(const Slot& slot) {
+  std::fprintf(g_file,
+               "{\"schema_version\":1,\"run_id\":\"");
+  json_escape(g_file, g_run_id.c_str());
+  std::fprintf(g_file, "\",\"phase\":\"");
+  json_escape(g_file, slot.phase);
+  std::fprintf(g_file, "\",\"event_seq\":%llu,\"event\":",
+               static_cast<unsigned long long>(slot.seq));
+  std::fputc('"', g_file);
+  json_escape(g_file, slot.event);
+  std::fprintf(g_file, "\",\"mono_ns\":%lld,\"pid\":%d,\"tid\":%d,\"thread_cpu_ns\":%lld,\"request_id\":",
+               static_cast<long long>(slot.mono_ns), slot.pid, slot.tid,
+               static_cast<long long>(slot.thread_cpu_ns));
+  std::fputc('"', g_file);
+  json_escape(g_file, slot.request_id);
+  std::fprintf(g_file, "\",\"chain_id\":null,\"input_id\":null,\"status\":\"");
+  json_escape(g_file, slot.status);
+  std::fprintf(g_file, "\"}\n");
+}
+
+void drain() {
+  if (!g_file) return;
+  const std::uint32_t claimed = g_write.load(std::memory_order_acquire);
+  while (g_read < claimed && g_read < kCapacity) {
+    if (g_slots[g_read].ready.load(std::memory_order_acquire) == 0) return;
+    write_slot(g_slots[g_read]);
+    ++g_read;
+  }
+  std::fflush(g_file);
+}
+
+void flush_loop() {
+  while (g_stop.load(std::memory_order_acquire) == 0) {
+    drain();
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+  }
+  drain();
+}
+}  // namespace
+
+std::atomic<int> interface_trace_flag{0};
+
+void interface_trace_event_slow(const char* event, const char* request_id,
+                                const char* status, const char* phase) {
+  // This mutex is the trace ring, not a product lock. Sequence and the
+  // monotonic stamp are taken together so a later sequence is not stamped
+  // earlier by another thread.
+  std::lock_guard<std::mutex> guard(g_emit_mu);
+  const std::uint32_t pos = g_write.fetch_add(1, std::memory_order_relaxed);
+  if (pos >= kCapacity) {
+    g_dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  Slot& slot = g_slots[pos];
+  slot.mono_ns = clock_ns(CLOCK_MONOTONIC);
+  slot.thread_cpu_ns = clock_ns(CLOCK_THREAD_CPUTIME_ID);
+  slot.pid = static_cast<int>(::getpid());
+  slot.tid = static_cast<int>(::syscall(SYS_gettid));
+  slot.seq = g_seq.fetch_add(1, std::memory_order_relaxed);
+  copy_field(slot.event, sizeof slot.event, event);
+  copy_field(slot.request_id, sizeof slot.request_id, request_id);
+  copy_field(slot.status, sizeof slot.status, status);
+  copy_field(slot.phase, sizeof slot.phase, phase);
+  slot.ready.store(1, std::memory_order_release);
+}
+
+void interface_trace_configure_from_env() {
+  if (g_started.exchange(1) != 0) return;
+  const char* enabled = std::getenv("ULD_OCC_INTERFACE_TRACE");
+  if (!enabled || std::strcmp(enabled, "1") != 0) return;
+  const char* path = std::getenv("ULD_OCC_TRACE_PATH");
+  const char* run = std::getenv("ULD_OCC_TRACE_RUN_ID");
+  if (!path || !path[0]) return;
+  if (run && run[0]) g_run_id = run;
+  g_file = std::fopen(path, "w");
+  if (!g_file) return;
+  g_flush = std::thread(flush_loop);
+  interface_trace_flag.store(1, std::memory_order_release);
+}
+
+void interface_trace_flush() {
+  std::lock_guard<std::mutex> guard(g_flush_mutex);
+  if (!g_file) return;
+  interface_trace_flag.store(0, std::memory_order_release);
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+  while (std::chrono::steady_clock::now() < deadline) {
+    const std::uint32_t claimed = std::min(g_write.load(std::memory_order_acquire), kCapacity);
+    bool ready = true;
+    for (std::uint32_t index = 0; index < claimed; ++index) {
+      if (g_slots[index].ready.load(std::memory_order_acquire) == 0) ready = false;
+    }
+    if (ready) break;
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+  if (g_flush.joinable()) {
+    g_stop.store(1, std::memory_order_release);
+    g_flush.join();
+  }
+  drain();
+  const auto dropped = g_dropped.load(std::memory_order_relaxed);
+  const auto seq = g_seq.fetch_add(1, std::memory_order_relaxed);
+  std::fprintf(g_file,
+               "{\"schema_version\":1,\"run_id\":\"");
+  json_escape(g_file, g_run_id.c_str());
+  std::fprintf(g_file,
+               "\",\"phase\":\"capture\",\"event_seq\":%llu,\"event\":\"trace_footer\","
+               "\"mono_ns\":%lld,\"pid\":%d,\"tid\":%d,\"thread_cpu_ns\":%lld,"
+               "\"request_id\":null,\"chain_id\":null,\"input_id\":null,\"status\":\"%llu\"}\n",
+               static_cast<unsigned long long>(seq),
+               static_cast<long long>(clock_ns(CLOCK_MONOTONIC)),
+               static_cast<int>(::getpid()),
+               static_cast<int>(::syscall(SYS_gettid)),
+               static_cast<long long>(clock_ns(CLOCK_THREAD_CPUTIME_ID)),
+               static_cast<unsigned long long>(dropped));
+  std::fflush(g_file);
+  std::fclose(g_file);
+  g_file = nullptr;
+}
+}  // namespace uld_occ_observer
