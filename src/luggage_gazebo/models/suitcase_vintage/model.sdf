<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Unit AABB (1 x 1 x 1 m) centered at origin. Spawners apply scale. -->
  <model name="suitcase_vintage">
    <link name="suitcase_link">
      <visual name="body_visual">
        <geometry>
          <mesh>
            <uri>model://suitcase_vintage/meshes/suitcase.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.32 0.24 0.14 1</ambient>
          <diffuse>0.48 0.36 0.20 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
