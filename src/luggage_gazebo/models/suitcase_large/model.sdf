<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Large checked bag: 80 x 50 x 32 cm, 23 kg. Loafbrr mesh. -->
  <model name="suitcase_large">
    <link name="suitcase_link">
      <inertial>
        <mass>23.0000</mass>
        <inertia>
          <ixx>0.675433</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.422933</iyy><iyz>0</iyz>
          <izz>1.705833</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry>
          <mesh>
            <uri>model://suitcase_loafbrr/meshes/suitcase.stl</uri>
            <scale>0.800000 0.500000 0.320000</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.15 1</ambient>
          <diffuse>0.20 0.20 0.24 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>0.800000 0.500000 0.320000</size></box></geometry>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
