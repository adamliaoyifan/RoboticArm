<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Carry-on: 55 x 40 x 25 cm, 8 kg. Loafbrr mesh (unit AABB * scale). -->
  <model name="suitcase_carryon">
    <link name="suitcase_link">
      <inertial>
        <mass>8.0000</mass>
        <inertia>
          <ixx>0.148333</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.243333</iyy><iyz>0</iyz>
          <izz>0.308333</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry>
          <mesh>
            <uri>model://suitcase_loafbrr/meshes/suitcase.stl</uri>
            <scale>0.550000 0.400000 0.250000</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.15 1</ambient>
          <diffuse>0.20 0.20 0.24 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>0.550000 0.400000 0.250000</size></box></geometry>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
