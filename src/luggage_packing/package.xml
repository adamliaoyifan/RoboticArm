<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>luggage_packing</name>
  <version>0.0.1</version>
  <description>EMS, placement scoring, and free-space packing algorithms.</description>
  <maintainer email="dev@todo.todo">RobotArm</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>luggage_msgs</exec_depend>
  <exec_depend>luggage_description</exec_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>ament_cmake_pytest</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <!-- NOTE: placement_planner_node imports luggage_planning.atlas_runtime
       lazily at runtime WITHOUT an exec_depend here: declaring it would
       close a colcon build cycle (luggage_perception test_depends on this
       package, luggage_planning exec_depends on luggage_perception). The
       ament environment exports every installed python package anyway. -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
