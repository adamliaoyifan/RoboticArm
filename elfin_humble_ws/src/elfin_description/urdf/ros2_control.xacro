<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Overridable so Fortress sim can spawn at observe. Mock/MVP keeps these. -->
  <xacro:arg name="initial_joint1" default="0.0"/>
  <xacro:arg name="initial_joint2" default="-0.5"/>
  <xacro:arg name="initial_joint3" default="0.0"/>
  <xacro:arg name="initial_joint4" default="0.0"/>
  <xacro:arg name="initial_joint5" default="0.0"/>
  <xacro:arg name="initial_joint6" default="0.0"/>

  <xacro:macro name="elfin_arm_joint_interfaces" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="elfin_ros2_control" params="hardware_plugin">
    <ros2_control name="ElfinSystem" type="system">
      <hardware>
        <plugin>${hardware_plugin}</plugin>
      </hardware>
      <!-- j2 URDF upper limit is 0.1745; do not start mock at 0. -->
      <xacro:elfin_arm_joint_interfaces name="elfin_joint1" initial="$(arg initial_joint1)"/>
      <xacro:elfin_arm_joint_interfaces name="elfin_joint2" initial="$(arg initial_joint2)"/>
      <xacro:elfin_arm_joint_interfaces name="elfin_joint3" initial="$(arg initial_joint3)"/>
      <xacro:elfin_arm_joint_interfaces name="elfin_joint4" initial="$(arg initial_joint4)"/>
      <xacro:elfin_arm_joint_interfaces name="elfin_joint5" initial="$(arg initial_joint5)"/>
      <xacro:elfin_arm_joint_interfaces name="elfin_joint6" initial="$(arg initial_joint6)"/>
    </ros2_control>
  </xacro:macro>
</robot>
