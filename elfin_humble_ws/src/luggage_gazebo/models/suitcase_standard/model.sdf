<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Medium checked bag: 70 x 45 x 28 cm, 15 kg. Vintage mesh. -->
  <model name="suitcase_standard">
    <link name="suitcase_link">
      <inertial>
        <mass>15.0000</mass>
        <inertia>
          <ixx>0.351125</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.710500</iyy><iyz>0</iyz>
          <izz>0.865625</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry>
          <mesh>
            <uri>model://suitcase_vintage/meshes/suitcase.stl</uri>
            <scale>0.700000 0.450000 0.280000</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.32 0.24 0.14 1</ambient>
          <diffuse>0.48 0.36 0.20 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>0.700000 0.450000 0.280000</size></box></geometry>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
