<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Pickup platform for suitcase spawning.
       Link origin at bottom-center on ground; geometry centered at z=height/2.
       Static model: suitcases rest on the collision surface via gravity. -->
  <model name="pickup_platform">
    <static>true</static>
    <link name="platform_link">
      <visual name="visual">
        <pose>0 0 0.43 0 0 0</pose>
        <geometry>
          <box>
            <size>1.0 1.0 0.86</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.30 0.35 1</ambient>
          <diffuse>0.35 0.40 0.45 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0.43 0 0 0</pose>
        <geometry>
          <box>
            <size>1.0 1.0 0.86</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
