<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- Airport luggage loading world for Gazebo Fortress (ros_gz_sim).
       ROS 2 port of the noetic airport_loading.world.
       Scene models (pedestal / pickup platform / container / suitcases) are
       spawned at runtime from scene_tf.yaml by gazebo_scene_spawner.py. -->
  <world name="airport_loading">
    <!-- sun and ground_plane are inlined (not model:// includes) so the world
         is self-contained and does not depend on the gz demo model paths. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Explicit server systems: UserCommands is required for the
         ros_gz_sim create/delete services used by the spawners. -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics">
      <dt>0.001</dt>
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Sensors system with GPU rendering: required by the D435 rgbd_camera
         on the robot. Headless rendering goes through EGL on the NVIDIA GPU
         (llvmpipe fails the launch GPU gate). -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.60 1</ambient>
      <background>0.65 0.70 0.75 1</background>
      <shadows>true</shadows>
    </scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Loading zone floor marking (visual aid); same pose as noetic -->
    <model name="loading_zone_marking">
      <static>true</static>
      <link name="link">
        <visual name="zone_visual">
          <pose>1.4 -0.7 0.001 0 0 0</pose>
          <geometry><box><size>1.6 1.4 0.002</size></box></geometry>
          <material>
            <ambient>0.9 0.85 0.2 1</ambient>
            <diffuse>0.95 0.90 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Preload each pre-scaled suitcase URI for the Ogre GPU cache.
         Static and spaced so mesh collisions do not overlap at z=-100. -->
    <include>
      <uri>model://suitcase_loafbrr_small</uri>
      <name>_preload_suitcase_loafbrr_small</name>
      <static>true</static>
      <pose>0 0 -100 0 0 0</pose>
    </include>
    <include>
      <uri>model://suitcase_loafbrr_medium</uri>
      <name>_preload_suitcase_loafbrr_medium</name>
      <static>true</static>
      <pose>3 0 -100 0 0 0</pose>
    </include>
    <include>
      <uri>model://suitcase_loafbrr_large</uri>
      <name>_preload_suitcase_loafbrr_large</name>
      <static>true</static>
      <pose>6 0 -100 0 0 0</pose>
    </include>
    <include>
      <uri>model://suitcase_vintage_small</uri>
      <name>_preload_suitcase_vintage_small</name>
      <static>true</static>
      <pose>9 0 -100 0 0 0</pose>
    </include>
    <include>
      <uri>model://suitcase_vintage_medium</uri>
      <name>_preload_suitcase_vintage_medium</name>
      <static>true</static>
      <pose>12 0 -100 0 0 0</pose>
    </include>
    <include>
      <uri>model://suitcase_vintage_large</uri>
      <name>_preload_suitcase_vintage_large</name>
      <static>true</static>
      <pose>15 0 -100 0 0 0</pose>
    </include>
  </world>
</sdf>
