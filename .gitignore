# Colcon outputs (never commit)
build/
install/
log/
build-production/
install-production/
install-mo/
log-production/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Large / regenerable models
*.pt
*.onnx
*.engine
/assimp-utils_*.deb

# Scan / archive artifacts (also listed under src/pointcloud/.gitignore)
*.las
*.laz
*.bin
*.tar

# Editor / local agent state
.vscode/
.codex/
.claude/
.agents/
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Docs kept in git: architecture/ and hardware/ only.
# Session notes, plans, research notes, and status/evidence stay local.
docs/agents/
docs/plans/
docs/research/
docs/status/

# Misc
*.swp
*~
.DS_Store
.env
.env.*
orin_perception_pack_*.tar.gz

# ST09 parallel workspaces: per-worktree build/install trees and
# test-built SDK sample binaries never enter commits.
build-st09/
install-st09/
build-st09-*/
install-st09-*/
SDK_sample/CppLinux_SDK/bin/
build-fresh-pd/
install-fresh-pd/
pydeps-frozen/
