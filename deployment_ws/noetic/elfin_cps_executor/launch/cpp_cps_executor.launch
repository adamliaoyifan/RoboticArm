<launch>
  <arg name="robot_ip" default="192.168.0.10"/>
  <arg name="robot_port" default="10003"/>
  <arg name="connect_on_start" default="true"/>

  <group ns="elfin_arm_controller">
    <node pkg="elfin_cps_executor" type="cpp_cps_trajectory_executor"
          name="cpp_cps_trajectory_executor" output="screen">
      <rosparam command="load" file="$(find elfin_cps_executor)/config/cps_executor.yaml"/>
      <param name="robot_ip" value="$(arg robot_ip)"/>
      <param name="robot_port" value="$(arg robot_port)"/>
      <param name="connect_on_start" value="$(arg connect_on_start)"/>
    </node>
  </group>
</launch>
