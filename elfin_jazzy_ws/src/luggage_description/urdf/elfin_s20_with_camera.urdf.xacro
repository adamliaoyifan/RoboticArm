<?xml version="1.0"?>
<!-- Name must stay S20 so elfin_moveit_config/config/S20.srdf matches. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="S20">

  <!-- Include the base Elfin S20 -->
  <xacro:include filename="$(find elfin_description)/urdf/S20.urdf.xacro"/>

  <!-- Suction panel assembly (p01-p05) on elfin_end_link -->
  <xacro:include filename="$(find luggage_description)/urdf/suction_panel_mount.urdf.xacro"/>
  <xacro:include filename="$(find luggage_description)/config/suction_flange_origin.xacro"/>

  <xacro:suction_panel_mount parent="${suction_flange_parent}">
    <origin xyz="${suction_flange_xyz}" rpy="${suction_flange_rpy}"/>
  </xacro:suction_panel_mount>

  <!-- EEF sensor mount adapter (3D-printed bracket on suction_panel) -->
  <xacro:include filename="$(find luggage_description)/urdf/eef_sensor_mount.urdf.xacro"/>
  <xacro:include filename="$(find luggage_description)/config/eef_mount_adapter_origin.xacro"/>

  <xacro:eef_sensor_mount parent="${adapter_mount_parent}">
    <origin xyz="${adapter_mount_xyz}" rpy="${adapter_mount_rpy}"/>
  </xacro:eef_sensor_mount>

  <!-- Include the RealSense D435 macro -->
  <xacro:include filename="$(find luggage_description)/urdf/realsense_d435.urdf.xacro"/>

  <!-- Mount params from config/camera_mount_origin.xacro (tuned via camera_mount_tune_gui) -->
  <xacro:include filename="$(find luggage_description)/config/camera_mount_origin.xacro"/>

  <xacro:realsense_d435 parent="${cam_mount_parent}">
    <origin xyz="${cam_mount_xyz}" rpy="${cam_mount_rpy}"/>
  </xacro:realsense_d435>

  <!-- use_gz_sim=true additionally emits the Gazebo Harmonic Ros2Control
       system plugin so controller_manager runs inside gz sim (hardware_plugin
       should then be gz_ros2_control/GazeboSimSystem and the sim controllers
       yaml below carries the relaxed Gazebo tolerances). -->
  <xacro:arg name="use_gz_sim" default="false"/>
  <xacro:arg name="controllers_yaml"
             default="$(find elfin_control)/config/elfin_controllers_sim.yaml"/>

  <gazebo reference="camera_link">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- gz_ros2_control only writes JointVelocityCmd after JTC is active.
       Without gravity on the moving links the JointPositionReset observe
       pose survives that gap (Noetic used kinematic SetPosition). The
       base is welded through world_base, not held by pedestal contact. -->
  <xacro:if value="$(arg use_gz_sim)">
    <gazebo reference="elfin_link1"><gravity>false</gravity></gazebo>
    <gazebo reference="elfin_link2"><gravity>false</gravity></gazebo>
    <gazebo reference="elfin_link3"><gravity>false</gravity></gazebo>
    <gazebo reference="elfin_link4"><gravity>false</gravity></gazebo>
    <gazebo reference="elfin_link5"><gravity>false</gravity></gazebo>
    <gazebo reference="elfin_link6"><gravity>false</gravity></gazebo>
    <gazebo reference="elfin_end_link"><gravity>false</gravity></gazebo>
  </xacro:if>

  <xacro:if value="$(arg use_gz_sim)">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_yaml)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
