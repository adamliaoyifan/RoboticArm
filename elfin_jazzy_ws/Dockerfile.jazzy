# Draft ROS 2 Jazzy image for elfin_jazzy_ws.
# Native Ubuntu 24.04 + /opt/ros/jazzy is the supported runtime.
# Interactive Gazebo / RViz2 MUST be run with --gpus all.
FROM osrf/ros:jazzy-desktop

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-moveit \
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ros-jazzy-controller-manager \
    ros-jazzy-xacro \
    ros-jazzy-rviz2 \
    ros-jazzy-ros-gz \
    ros-jazzy-gz-ros2-control \
    python3-colcon-common-extensions \
    python3-rosdep \
    mesa-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /colcon_ws
COPY src ./src
# COLCON_IGNORE on ROS 1 packages is expected until they are ported.

SHELL ["/bin/bash", "-c"]
RUN source /opt/ros/jazzy/setup.bash \
    && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && echo "source /colcon_ws/install/setup.bash" >> /root/.bashrc

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
